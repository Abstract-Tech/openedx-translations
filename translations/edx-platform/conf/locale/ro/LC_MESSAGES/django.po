msgstr "Fotografia cu tine arată toată fața ta?"

#: lms/templates/verify_student/review_photos_step.underscore
msgid "Is your name on your ID readable?"
msgstr "Numele tău de pe actul tău de identitate poate fi citit?"

#: lms/templates/verify_student/review_photos_step.underscore
msgid "Does the name on your ID match your account name: %(fullName)s?"
msgstr ""
"Se potrivește numele de pe actul tău de identitate cu numele contului: "
